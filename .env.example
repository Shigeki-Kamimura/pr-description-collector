# GitHub 認証（どちらか片方）
# - 個人トークン（PAT）または Actions 等のトークン
GITHUB_TOKEN=
# GITHUB_PAT=

# GitHub App 認証（PATを使わない場合）
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# GitHub APIリクエストのタイムアウト（秒、任意。デフォルト: 180）
# GITHUB_REQUEST_TIMEOUT_SECONDS=180
# GITHUB_APP_PRIVATE_KEY の設定方法:
# - .env ファイルに直接書く場合は、PEM 形式の秘密鍵をそのまま複数行で貼り付ける（引用符は付けない）
#   例:
#   GITHUB_APP_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----
#   ...（中略）...
#   -----END PRIVATE KEY-----
# - CI / ホスティングサービスで 1 行の環境変数として設定する場合は、改行を \n に置き換える
#   例:
#   # GITHUB_APP_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n

# OneDrive（Microsoft Graph）
# 開発用: /me/drive を操作できるアクセストークンを直で設定する

# Cookie署名用（必須）
# 本番は十分に長いランダム文字列を設定
SESSION_SECRET=
# 開発環境で未設定の場合は固定の開発用secretへフォールバックしますが、明示設定を推奨
# 例: SESSION_SECRET=dev-local-session-secret-change-me
# メモリトークンストアの上限セッション数（任意、デフォルト: 500）
# ONEDRIVE_TOKEN_STORE_MAX_SESSIONS=500
# 本番でメモリ tokenStore を暫定利用する場合のみ true/1（非推奨）
# true/1 を有効化すると、再起動・再デプロイ・スケールアウト時に OAuth セッションは全喪失します。
# 本番では Redis / DB などの永続ストア実装を必須にしてください。
# ONEDRIVE_ALLOW_IN_MEMORY_TOKEN_STORE_IN_PRODUCTION=false

# OAuth（サーバーサイド: Authorization Code）
# ONEDRIVE_TENANT=common or your-tenant-id
# クライアントID
# ONEDRIVE_CLIENT_ID=

# pr-description-collectorクライアントシークレット
# ONEDRIVE_CLIENT_SECRET=
# リダイレクトURI
# ONEDRIVE_REDIRECT_URI=
# リバースプロキシ配下で x-forwarded-proto を HTTPS 判定に使う場合のみ true/1 を設定
# ONEDRIVE_TRUST_X_FORWARDED_PROTO=true
# 信頼する proxy host の許可リスト（カンマ区切り）
# ONEDRIVE_TRUSTED_PROXY_HOSTS=localhost:5173,127.0.0.1:5173
# 任意: リバースプロキシから渡す共有シークレット
# 設定時は x-onedrive-proxy-secret ヘッダーが一致する場合のみ X-Forwarded-* を信頼
# ONEDRIVE_TRUST_PROXY_SHARED_SECRET=
# OAuthトークン交換リクエストのタイムアウト（秒、任意。デフォルト: 180）
# ONEDRIVE_OAUTH_REQUEST_TIMEOUT_SECONDS=180
# エビデンス画像1件あたりの最大ダウンロードサイズ（KB、任意。デフォルト: 10240 = 10MB）
# Microsoft Graph 単純アップロード上限（250MB）を超える値は 250MB に丸められます。
# ONEDRIVE_EVIDENCE_IMAGE_MAX_KB=10240
# エビデンス画像の処理上限件数（任意。デフォルト: 20）
# ONEDRIVE_EVIDENCE_IMAGE_MAX_COUNT=20
# 旧設定（bytes）: ONEDRIVE_EVIDENCE_IMAGE_MAX_BYTES=10485760
# エビデンス画像の許可ドメイン（カンマ区切り、任意）
# 未設定時: github.com,user-images.githubusercontent.com,github-production-user-asset-6210df.s3.amazonaws.com
# ONEDRIVE_EVIDENCE_IMAGE_ALLOWED_HOSTS=github.com,user-images.githubusercontent.com
# 保存先フォルダ（OneDriveのルート配下）
# ONEDRIVE_BASE_FOLDER="pr-description-collector"

# 仕事用フォルダ配下に保存したい場合
# ONEDRIVE_WORK_FOLDER="work"

# 開発サーバー（ViteはHTTPで起動。利用者アクセスはHTTPS終端を必須とする）
# DEV_SERVER_HOST=127.0.0.1
# DEV_SERVER_PORT=5174

# OAuthリダイレクトURI例（HTTPS入口を必須とし、Nginx等の入口URLを指定）
# ONEDRIVE_REDIRECT_URI=https://localhost:5173/auth/onedrive/callback
