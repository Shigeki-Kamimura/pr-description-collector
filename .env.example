# GitHub 認証（どちらか片方）
# - 個人トークン（PAT）または Actions 等のトークン
GITHUB_TOKEN=
# GITHUB_PAT=

# GitHub App 認証（PATを使わない場合）
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY の設定方法:
# - .env ファイルに直接書く場合は、PEM 形式の秘密鍵をそのまま複数行で貼り付ける（引用符は付けない）
#   例:
#   GITHUB_APP_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----
#   ...（中略）...
#   -----END PRIVATE KEY-----
# - CI / ホスティングサービスで 1 行の環境変数として設定する場合は、改行を \n に置き換える
#   例:
#   # GITHUB_APP_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n

# OneDrive（Microsoft Graph）
# 開発用: /me/drive を操作できるアクセストークンを直で設定する

# Cookie署名用（必須）
# 本番は十分に長いランダム文字列を設定
SESSION_SECRET=
# メモリトークンストアの上限セッション数（任意、デフォルト: 500）
# ONEDRIVE_TOKEN_STORE_MAX_SESSIONS=500

# OAuth（サーバーサイド: Authorization Code）
# ONEDRIVE_TENANT=common or your-tenant-id
# クライアントID
# ONEDRIVE_CLIENT_ID=

# pr-description-collectorクライアントシークレット
# ONEDRIVE_CLIENT_SECRET=
# リダイレクトURI
# ONEDRIVE_REDIRECT_URI=
# リバースプロキシ配下で x-forwarded-proto を HTTPS 判定に使う場合のみ true/1 を設定
# ONEDRIVE_TRUST_X_FORWARDED_PROTO=true
# 信頼する proxy host の許可リスト（カンマ区切り）
# ONEDRIVE_TRUSTED_PROXY_HOSTS=localhost:5173,127.0.0.1:5173
# 保存先フォルダ（OneDriveのルート配下）
# ONEDRIVE_BASE_FOLDER="pr-description-collector"

# 仕事用フォルダ配下に保存したい場合
# ONEDRIVE_WORK_FOLDER="work"

# 開発サーバー（ViteはHTTPで起動。利用者アクセスはHTTPS終端を必須とする）
# DEV_SERVER_HOST=127.0.0.1
# DEV_SERVER_PORT=5174

# OAuthリダイレクトURI例（HTTPS入口を必須とし、Nginx等の入口URLを指定）
# ONEDRIVE_REDIRECT_URI=https://localhost:5173/auth/onedrive/callback
